# 复制本文件为 .env 后填写实际值。
# 注意：所有 VITE_ 前缀的变量都会被打包进浏览器端产物，只能放公开信息。
# 真正的密钥（LOVABLE_API_KEY / RETELL_API_KEY / RESEND_API_KEY 等）
# 必须配置在 Supabase Edge Function 的 Secrets 中，切勿写在这里。

# Supabase 项目 ID
VITE_SUPABASE_PROJECT_ID="your-project-id"

# Supabase 匿名公开密钥（anon / publishable key，设计上可公开）
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"

# Supabase 项目地址
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Retell 语音坐席 ID（可选，不填使用代码内置默认值）
VITE_RETELL_AGENT_ID=""
